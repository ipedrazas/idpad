# Copy to .env and adjust. `task up` reads this file through compose.

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=idpad
POSTGRES_PASSWORD=idpad
POSTGRES_DB=idpad
# Host port the database is published on. Change it if 5432 is already taken.
POSTGRES_PORT=5432

# --- API ---------------------------------------------------------------------
# Connection string used by the API container. The host is the compose service
# name; for `task dev` (API on the host) use localhost instead.
DATABASE_URL=postgres://idpad:idpad@db:5432/idpad?sslmode=disable
API_PORT=8080
IDPAD_LOG_LEVEL=info
IDPAD_LOG_FORMAT=json
# Comma-separated browser origins, or * for any. The SPA is served same-origin
# in compose, so this only matters for `task dev`.
IDPAD_CORS_ORIGINS=*
# Apply pending migrations during API start-up.
IDPAD_MIGRATE_ON_START=true

# --- Bootstrapping an existing Postgres --------------------------------------
# Only needed for `task db-create`, which creates the role and database above on
# a server you already run. `task up` does not use these: the postgres container
# creates both from POSTGRES_* on first boot.
# PGHOST=localhost
# PGSUPERUSER=postgres
# PGSUPERPASSWORD=

# --- Web ---------------------------------------------------------------------
WEB_PORT=5173

# --- Images (compose.prod.yaml) ----------------------------------------------
IMAGE_TAG=latest
